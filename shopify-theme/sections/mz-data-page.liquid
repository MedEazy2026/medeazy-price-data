{
  "@context": "https://schema.org",
  "@type": "Dataset",
  "name": "UK weight loss medicine prices (MedEazy)",
  "description": "Prices for Mounjaro, Wegovy, the Wegovy pill and Orlistat from GPhC-registered UK online pharmacies, with a timestamped record of every price change, updated hourly.",
  "url": "{{ shop.url }}/pages/data",
  "keywords": ["Mounjaro price", "Wegovy price", "weight loss injection cost", "UK pharmacy prices", "GLP-1"],
  "license": "https://creativecommons.org/licenses/by/4.0/",
  "isAccessibleForFree": true,
  "creator": { "@type": "Organization", "name": "MedEazy", "url": "{{ shop.url }}" },
  "spatialCoverage": "United Kingdom",
  "temporalCoverage": "2026-10-04/..",
  "distribution": [
    { "@type": "DataDownload", "encodingFormat": "text/csv", "name": "Latest prices", "contentUrl": "{{ base }}/medeazy-prices-latest.csv" },
    { "@type": "DataDownload", "encodingFormat": "text/csv", "name": "Price change history", "contentUrl": "{{ base }}/medeazy-prices-history.csv" },
    { "@type": "DataDownload", "encodingFormat": "text/csv", "name": "Monthly price index", "contentUrl": "{{ base }}/medeazy-monthly-index.csv" }
  ]
}
</script>

<script>
(function () {
  var root = document.getElementById('mzd-root');
  if (!root) return;
  var base = root.getAttribute('data-base');

  function money(n) {
    var r = Math.round(n * 100) / 100;
    return '£' + (r % 1 === 0 ? r.toFixed(0) : r.toFixed(2));
  }
  function ukDate(iso) {
    return new Date(iso + 'T12:00:00').toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' });
  }
  function setAll(key, text) {
    root.querySelectorAll('[data-mzd="' + key + '"]').forEach(function (el) { el.textContent = text; });
  }

  var copyBtn = document.getElementById('mzd-copy');
  if (copyBtn) copyBtn.addEventListener('click', function () {
    var text = document.getElementById('mzd-credit').textContent;
    var done = function () { copyBtn.textContent = 'Copied'; setTimeout(function () { copyBtn.textContent = 'Copy credit line'; }, 2000); };
    if (navigator.clipboard && navigator.clipboard.writeText) navigator.clipboard.writeText(text).then(done, function () {});
  });

  fetch(base + '/summary.json', { cache: 'no-store' })
    .then(function (r) { if (!r.ok) throw new Error(r.status); return r.json(); })
    .then(function (s) {
      var doses = s.doses || [];
      var find = function (t, d) { return doses.filter(function (x) { return x.treatment === t && x.dose === d; })[0]; };

      setAll('pharmacies', String(s.pharmacies_tracked));
      setAll('listings', Number(s.listings).toLocaleString('en-GB'));
      setAll('checked', ukDate(s.last_checked_date));
      setAll('since', ukDate(s.tracking_since));

      var m10 = find('Mounjaro', '10mg');
      if (m10) { setAll('gap10', money(m10.gap)); setAll('low10', money(m10.lowest)); setAll('high10', money(m10.highest)); }
      var m25 = find('Mounjaro', '2.5mg');
      if (m25) setAll('mj25', money(m25.lowest));
      if (s.lowest_by_treatment && s.lowest_by_treatment['Wegovy injection'] != null) setAll('weg', money(s.lowest_by_treatment['Wegovy injection']));

      var mj = doses.filter(function (x) { return x.treatment === 'Mounjaro'; });
      if (!mj.length) return;
      var max = Math.ceil(Math.max.apply(null, mj.map(function (x) { return x.highest; })) / 100) * 100;
      var rows = document.getElementById('mzd-rows');
      rows.innerHTML = '';
      mj.forEach(function (d) {
        var l = d.lowest / max * 100, h = d.highest / max * 100;
        var row = document.createElement('div');
        row.className = 'row';
        row.innerHTML = '<div class="dose"></div><div class="track"><div class="bar"></div><span class="lab"></span><span class="lab"></span></div><div class="gap"></div>';
        row.querySelector('.dose').textContent = d.dose;
        var bar = row.querySelector('.bar'); bar.style.left = l + '%'; bar.style.width = (h - l) + '%';
        var labs = row.querySelectorAll('.lab');
        labs[0].style.right = (101 - l) + '%'; labs[0].textContent = money(d.lowest);
        labs[1].style.left = (h + 1) + '%'; labs[1].textContent = money(d.highest);
        row.querySelector('.gap').textContent = money(d.gap) + ' gap';
        rows.appendChild(row);
      });
      var axis = document.getElementById('mzd-axis');
      axis.innerHTML = '';
      for (var v = 0; v <= max; v += max / 4) {
        var sp = document.createElement('span'); sp.textContent = '£' + Math.round(v); axis.appendChild(sp);
      }
    })
    .catch(function () { /* keep the built-in figures */ });
})();
</script>

