{%- comment -%}
  MedEazy /data page: open price data, methodology, downloads and licence.
  Figures load live from the price-data site (summary.json); the numbers
  written below are fallbacks shown if that request fails.
{%- endcomment -%}
{%- assign base = section.settings.data_base_url | default: 'https://data.medeazy.co.uk' -%}

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700;800&family=Instrument+Serif:ital@0;1&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">

<style>
  .mzd { --teal:#0E7C7B; --teal-d:#0B6564; --ink:#0F2A2E; --mute:#4A5E61; --mute2:#5A6D70; --line:#E2ECEA; --mist:#F2F8F7; --chip:#DDEFEC;
         font-family: Manrope, system-ui, -apple-system, "Segoe UI", sans-serif; color: var(--ink); background: #fff; line-height: 1.5; }
  .mzd *, .mzd *::before, .mzd *::after { box-sizing: border-box; }
  .mzd h1, .mzd h2, .mzd h3, .mzd p { font-family: inherit; color: inherit; margin: 0; text-transform: none; text-align: left; }
  /* Dawn hides empty divs (div:empty) and adds letter-spacing; undo both here */
  .mzd div:empty { display: block; }
  .mzd, .mzd p, .mzd td, .mzd th, .mzd span, .mzd a, .mzd div, .mzd dt, .mzd dd, .mzd button, .mzd pre { letter-spacing: normal; }
  .mzd table, .mzd th, .mzd td { border: 0 !important; box-shadow: none; }
  .mzd td { border-top: 1px solid var(--line) !important; }
  .mzd a { color: var(--teal-d); }
  .mzd a:hover { color: #084847; }
  .mzd .wrap { max-width: 1120px; margin: 0 auto; padding-left: 24px; padding-right: 24px; }
  .mzd .serif { font-family: "Instrument Serif", Georgia, serif; font-style: italic; font-weight: 400; }
  .mzd .mono { font-family: "JetBrains Mono", ui-monospace, monospace; }
  .mzd .eyebrow { font-size: 13px; font-weight: 800; letter-spacing: .08em; color: var(--teal-d); text-transform: uppercase; }

  /* hero */
  .mzd .hero { background: var(--mist); border-bottom: 1px solid var(--line); }
  .mzd .hero .wrap { padding-top: 72px; padding-bottom: 64px; display: flex; flex-direction: column; gap: 24px; }
  .mzd .chips { display: flex; flex-wrap: wrap; gap: 10px; }
  .mzd .chip { font-size: 13px; font-weight: 700; color: var(--teal-d); background: var(--chip); padding: 6px 12px; border-radius: 999px; }
  .mzd .hero h1 { font-size: 56px; line-height: 1.05; letter-spacing: -.03em; font-weight: 800; max-width: 820px; }
  .mzd .hero h1 .serif { color: var(--teal); }
  .mzd .lede { font-size: 19px; line-height: 1.6; color: #3F5457; max-width: 720px; }
  .mzd .btns { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 8px; }
  .mzd .btn { display: inline-flex; align-items: center; gap: 10px; font-weight: 700; font-size: 16px; padding: 15px 24px; border-radius: 12px; min-height: 44px; text-decoration: none; }
  .mzd .btn-p { background: var(--teal); color: #fff; }
  .mzd .btn-p:hover { background: var(--teal-d); color: #fff; }
  .mzd .btn-s { background: #fff; color: var(--ink); border: 1.5px solid #C9DCD9; }
  .mzd .btn-s:hover { color: var(--ink); border-color: var(--teal); }
  .mzd .btn-t { color: var(--teal-d); padding-left: 8px; padding-right: 8px; }
  .mzd .updated { font-size: 14px; color: var(--mute2); }

  /* sections */
  .mzd .sec { padding-top: 48px; padding-bottom: 48px; }
  .mzd h2.t { font-size: 30px; letter-spacing: -.02em; font-weight: 800; margin-bottom: 8px; }
  .mzd .sub { color: var(--mute); font-size: 16px; margin-bottom: 28px; }
  .mzd .grid { display: grid; gap: 16px; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); }
  .mzd .grid-300 { grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); }
  .mzd .card { border: 1px solid var(--line); border-radius: 16px; padding: 24px; display: flex; flex-direction: column; gap: 8px; background: #fff; }
  .mzd .stat { font-size: 44px; font-weight: 800; letter-spacing: -.03em; color: var(--teal); line-height: 1.1; }
  .mzd .stat-l { font-size: 15px; font-weight: 700; }
  .mzd .stat-d { font-size: 14px; color: var(--mute); line-height: 1.5; }

  /* chart */
  .mzd .panel { border: 1px solid var(--line); border-radius: 20px; padding: 32px; display: flex; flex-direction: column; gap: 24px; }
  .mzd .panel-h { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: flex-end; gap: 16px; }
  .mzd .panel-h h2 { font-size: 26px; letter-spacing: -.02em; font-weight: 800; margin-bottom: 6px; }
  .mzd .panel-h p { color: var(--mute); font-size: 15px; }
  .mzd .rows { display: flex; flex-direction: column; gap: 14px; }
  .mzd .row { display: grid; grid-template-columns: 72px minmax(0, 1fr) 96px; align-items: center; gap: 16px; }
  .mzd .row .dose { font-weight: 700; font-size: 15px; }
  .mzd .track { position: relative; height: 32px; background: var(--mist); border-radius: 8px; }
  .mzd .bar { position: absolute; top: 10px; height: 12px; border-radius: 6px; background: var(--teal); opacity: .85; }
  .mzd .lab { position: absolute; top: 7px; font-size: 13px; font-weight: 700; color: var(--ink); white-space: nowrap; }
  .mzd .gap { font-size: 15px; font-weight: 800; color: #9A4A0B; text-align: right; }
  .mzd .axis { display: flex; justify-content: space-between; font-size: 12px; color: var(--mute2); padding: 0 112px 0 88px; }

  /* downloads */
  .mzd .dl { border: 1px solid var(--line); border-radius: 16px; padding: 24px; display: flex; flex-direction: column; gap: 12px; }
  .mzd .dl.main { border: 1.5px solid var(--teal); background: var(--mist); }
  .mzd .dl .k { font-size: 12px; font-weight: 800; letter-spacing: .08em; color: var(--mute2); }
  .mzd .dl.main .k { color: var(--teal-d); }
  .mzd .dl .f { font-size: 15px; font-weight: 500; word-break: break-all; }
  .mzd .dl .d { font-size: 14px; color: var(--mute); line-height: 1.5; }
  .mzd .dl .btn { margin-top: auto; justify-content: center; padding: 13px 18px; border-radius: 10px; font-size: 16px; }
  .mzd h3.c { margin: 40px 0 12px; font-size: 18px; font-weight: 700; }
  .mzd .tbl { overflow-x: auto; border: 1px solid var(--line); border-radius: 12px; }
  .mzd table { width: 100%; min-width: 760px; border-collapse: collapse; font-size: 14px; margin: 0; }
  .mzd th { background: var(--mist); text-align: left; padding: 12px 16px; font-weight: 700; border: 0; }
  .mzd td { padding: 11px 16px; border: 0; border-top: 1px solid var(--line); color: #3F5457; vertical-align: top; }
  .mzd td.n { font-family: "JetBrains Mono", monospace; font-size: 13px; color: var(--teal-d); white-space: nowrap; }
  .mzd td.e { font-family: "JetBrains Mono", monospace; font-size: 13px; color: var(--ink); white-space: nowrap; }

  /* licence */
  .mzd .lic { background: var(--ink); color: #fff; }
  .mzd .lic .wrap { padding-top: 64px; padding-bottom: 64px; display: grid; gap: 48px; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); }
  .mzd .lic h2 { font-size: 34px; letter-spacing: -.02em; line-height: 1.15; font-weight: 800; color: #fff; }
  .mzd .lic h2 .serif, .mzd .lic .eyebrow { color: #8FD3CC; }
  .mzd .lic p { font-size: 16px; line-height: 1.65; color: #C9D8D7; }
  .mzd .lic a { color: #8FD3CC; font-weight: 700; }
  .mzd .lic .col { display: flex; flex-direction: column; gap: 16px; }
  .mzd .credit { background: #17393E; border: 1px solid #2B5459; border-radius: 16px; padding: 24px; display: flex; flex-direction: column; gap: 14px; }
  .mzd .credit .lbl { font-size: 14px; font-weight: 700; color: #C9D8D7; }
  .mzd .credit .line { font-family: "JetBrains Mono", monospace; font-size: 15px; background: var(--ink); border-radius: 10px; padding: 16px; line-height: 1.5; color: #fff; }
  .mzd .credit .note { font-size: 14px; color: #C9D8D7; line-height: 1.6; }
  .mzd .credit .note .mono { color: #fff; }
  .mzd .copy { align-self: flex-start; font-family: inherit; font-size: 15px; font-weight: 700; color: var(--ink); background: #8FD3CC; border: 0; border-radius: 10px; padding: 12px 18px; min-height: 44px; cursor: pointer; }
  .mzd .copy:hover { background: #A7DFD9; }
  .mzd .do { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12px; font-size: 14px; line-height: 1.5; }
  .mzd .do > div { background: #17393E; border-radius: 12px; padding: 16px; }
  .mzd .do strong { display: block; margin-bottom: 6px; color: #fff; }
  .mzd .do span { color: #C9D8D7; }

  /* methodology */
  .mzd .meth { padding-top: 72px; padding-bottom: 32px; }
  .mzd .meth h2 { font-size: 34px; letter-spacing: -.02em; font-weight: 800; margin: 10px 0 12px; }
  .mzd .meth .intro { margin-bottom: 36px; color: var(--mute); font-size: 17px; line-height: 1.6; max-width: 720px; }
  .mzd .step { border: 1px solid var(--line); border-radius: 16px; padding: 26px; display: flex; flex-direction: column; gap: 10px; }
  .mzd .step .num { width: 36px; height: 36px; border-radius: 10px; background: var(--chip); color: var(--teal-d); font-weight: 800; display: flex; align-items: center; justify-content: center; }
  .mzd .step h3 { margin-top: 4px; font-size: 18px; font-weight: 700; }
  .mzd .step p { font-size: 15px; line-height: 1.6; color: #3F5457; }
  .mzd .box { border-radius: 16px; padding: 24px; }
  .mzd .box h3 { margin: 0 0 10px; font-size: 17px; font-weight: 700; }
  .mzd .box.warn { background: #FFF6EC; }
  .mzd .box.warn h3 { color: #7A3A06; }
  .mzd .box.warn p { font-size: 15px; line-height: 1.6; color: #5B3410; }
  .mzd .box.log { background: var(--mist); font-size: 14px; line-height: 1.7; color: #3F5457; }
  .mzd .box.log strong { color: var(--ink); }

  /* embed + press */
  .mzd .embed { border: 1px solid var(--line); border-radius: 20px; padding: 32px; display: grid; gap: 32px; align-items: center; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); }
  .mzd .embed h2, .mzd .press h2 { font-size: 26px; letter-spacing: -.02em; font-weight: 800; margin-bottom: 10px; }
  .mzd .embed p { font-size: 16px; line-height: 1.6; color: var(--mute); }
  .mzd .code { background: var(--ink); color: #D7ECE9; border-radius: 12px; padding: 20px; font-family: "JetBrains Mono", monospace; font-size: 13px; line-height: 1.6; overflow-x: auto; white-space: pre; margin: 0; }
  .mzd .press { background: var(--mist); border-radius: 20px; padding: 36px; display: grid; gap: 32px; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); }
  .mzd .press p { font-size: 16px; line-height: 1.6; color: #3F5457; }
  .mzd .press dl { margin: 0; display: flex; flex-direction: column; gap: 10px; font-size: 15px; }
  .mzd .press dt { color: var(--mute2); }
  .mzd .press dd { margin: 0; font-weight: 700; }
  .mzd .disc { border-top: 1px solid var(--line); }
  .mzd .disc .wrap { padding-top: 32px; padding-bottom: 32px; font-size: 13px; line-height: 1.6; color: var(--mute2); }

  @media (max-width: 749px) {
    .mzd .hero .wrap { padding-top: 48px; padding-bottom: 44px; }
    .mzd .hero h1 { font-size: 38px; }
    .mzd .lede { font-size: 17px; }
    .mzd .panel, .mzd .embed, .mzd .press { padding: 22px; }
    .mzd .row { grid-template-columns: 56px minmax(0, 1fr) 72px; gap: 10px; }
    .mzd .gap { font-size: 13px; }
    .mzd .axis { padding: 0 82px 0 66px; }
    .mzd .do { grid-template-columns: 1fr; }
    .mzd .lic h2, .mzd .meth h2 { font-size: 28px; }
  }
</style>

<div class="mzd" id="mzd-root" data-base="{{ base }}">

  <section class="hero">
    <div class="wrap">
      <div class="chips">
        <span class="chip">Open data</span>
        <span class="chip">CC BY 4.0</span>
        <span class="chip">Updated hourly</span>
      </div>
      <h1>UK weight loss medicine prices, <span class="serif">in the open.</span></h1>
      <p class="lede">Prices for Mounjaro, Wegovy, the Wegovy pill and Orlistat from <span data-mzd="pharmacies">74</span> GPhC-checked UK pharmacies, with every price change recorded. Free for journalists, researchers and businesses to use, as long as you credit MedEazy.</p>
      <div class="btns">
        <a class="btn btn-p" href="#downloads">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3v12"/><path d="m7 10 5 5 5-5"/><path d="M5 21h14"/></svg>
          Download the CSV
        </a>
        <a class="btn btn-s" href="#methodology">Read the methodology</a>
        <a class="btn btn-t" href="#press">Press enquiries →</a>
      </div>
      <p class="updated">Last checked <span data-mzd="checked">4 October 2026</span> · Tracking since <span data-mzd="since">4 October 2026</span></p>
    </div>
  </section>

  <section class="wrap sec" aria-labelledby="mzd-h-numbers" style="padding-top:64px;padding-bottom:24px">
    <h2 class="t" id="mzd-h-numbers">This month in numbers</h2>
    <p class="sub">Snapshot from today's data. Every figure can be reproduced from the CSV.</p>
    <div class="grid">
      <div class="card">
        <div class="stat" data-mzd="gap10">£126</div>
        <div class="stat-l">Mounjaro 10mg price gap</div>
        <div class="stat-d">Same pen, <span data-mzd="low10">£198</span> at the cheapest pharmacy and <span data-mzd="high10">£324</span> at the dearest.</div>
      </div>
      <div class="card">
        <div class="stat" data-mzd="pharmacies">74</div>
        <div class="stat-l">Pharmacies tracked</div>
        <div class="stat-d">Each one checked against the GPhC register before listing.</div>
      </div>
      <div class="card">
        <div class="stat" data-mzd="mj25">£99</div>
        <div class="stat-l">Cheapest Mounjaro start dose</div>
        <div class="stat-d">2.5mg monthly supply, lowest price on MedEazy today.</div>
      </div>
      <div class="card">
        <div class="stat" data-mzd="weg">£49</div>
        <div class="stat-l">Cheapest Wegovy injection</div>
        <div class="stat-d">Starting dose, lowest price on MedEazy today.</div>
      </div>
    </div>
  </section>

  <section class="wrap sec" aria-labelledby="mzd-h-spread">
    <div class="panel">
      <div class="panel-h">
        <div>
          <h2 id="mzd-h-spread">Mounjaro: lowest to highest price by dose</h2>
          <p>Monthly supply (4 pens) · <span data-mzd="checked">4 October 2026</span></p>
        </div>
        <a href="#embed" style="font-weight:700;font-size:15px">Embed this chart</a>
      </div>
      <div class="rows" id="mzd-rows">
        {%- assign fb = '2.5mg,99,214|5mg,128,244|7.5mg,178,294|10mg,198,324|12.5mg,212,344|15mg,229,359' | split: '|' -%}
        {%- for r in fb -%}
          {%- assign p = r | split: ',' -%}
          {%- assign lo = p[1] | times: 1.0 -%}
          {%- assign hi = p[2] | times: 1.0 -%}
          {%- assign l = lo | divided_by: 4.0 -%}
          {%- assign h = hi | divided_by: 4.0 -%}
          {%- assign w = h | minus: l -%}
          {%- assign rp = 101 | minus: l -%}
          {%- assign lp = h | plus: 1 -%}
          {%- assign g = hi | minus: lo | round -%}
          <div class="row">
            <div class="dose">{{ p[0] }}</div>
            <div class="track">
              <div class="bar" style="left:{{ l }}%;width:{{ w }}%"></div>
              <span class="lab" style="right:{{ rp }}%">£{{ p[1] }}</span>
              <span class="lab" style="left:{{ lp }}%">£{{ p[2] }}</span>
            </div>
            <div class="gap">£{{ g }} gap</div>
          </div>
        {%- endfor -%}
      </div>
      <div class="axis" id="mzd-axis"><span>£0</span><span>£100</span><span>£200</span><span>£300</span><span>£400</span></div>
    </div>
  </section>

  <section class="wrap sec" id="downloads" aria-labelledby="mzd-h-dl" style="padding-top:32px">
    <h2 class="t" id="mzd-h-dl">Download the data</h2>
    <p class="sub">Plain CSV, UTF-8, refreshed automatically every hour. Files are served from data.medeazy.co.uk.</p>
    <div class="grid grid-300">
      <div class="dl main">
        <div class="k">MOST USED</div>
        <div class="f mono">medeazy-prices-latest.csv</div>
        <div class="d">Every current price, with the date it took effect. <span data-mzd="listings">1,162</span> rows.</div>
        <a class="btn btn-p" href="{{ base }}/medeazy-prices-latest.csv" download>Download latest</a>
      </div>
      <div class="dl">
        <div class="k">HISTORY</div>
        <div class="f mono">medeazy-prices-history.csv</div>
        <div class="d">Every price change, new listing and removal since <span data-mzd="since">4 October 2026</span>, timestamped to the hour.</div>
        <a class="btn btn-s" href="{{ base }}/medeazy-prices-history.csv" download>Download history</a>
      </div>
      <div class="dl">
        <div class="k">MONTHLY SUMMARY</div>
        <div class="f mono">medeazy-monthly-index.csv</div>
        <div class="d">Lowest, median and highest price per product and dose, by month.</div>
        <a class="btn btn-s" href="{{ base }}/medeazy-monthly-index.csv" download>Download summary</a>
      </div>
    </div>

    <h3 class="c">What's in each row of the latest file</h3>
    <div class="tbl">
      <table>
        <thead><tr><th scope="col">Column</th><th scope="col">Example</th><th scope="col">Meaning</th></tr></thead>
        <tbody>
          <tr><td class="n">treatment</td><td class="e">Mounjaro</td><td>Treatment as listed on MedEazy</td></tr>
          <tr><td class="n">active_ingredient</td><td class="e">tirzepatide</td><td>Generic name</td></tr>
          <tr><td class="n">product</td><td class="e">Xenical</td><td>Brand or product (differs from treatment for Orlistat)</td></tr>
          <tr><td class="n">dose</td><td class="e">10mg</td><td>Strength</td></tr>
          <tr><td class="n">pharmacy</td><td class="e">Medicine Market Place</td><td>Trading name of the online pharmacy</td></tr>
          <tr><td class="n">gphc_number</td><td class="e">1116946</td><td>GPhC registration number we verified</td></tr>
          <tr><td class="n">pharmacy_website</td><td class="e">medicinemarketplace.com</td><td>The pharmacy's own domain</td></tr>
          <tr><td class="n">price_gbp</td><td class="e">198.00</td><td>Monthly price shown on MedEazy</td></tr>
          <tr><td class="n">price_since</td><td class="e">2026-10-04</td><td>Date this price took effect on MedEazy</td></tr>
          <tr><td class="n">discount_code</td><td class="e">LWSAVE40</td><td>Verified code shown alongside the price, if any</td></tr>
        </tbody>
      </table>
    </div>
  </section>

  <section class="lic" aria-labelledby="mzd-h-licence">
    <div class="wrap">
      <div class="col">
        <span class="eyebrow">Licence</span>
        <h2 id="mzd-h-licence">Free to use. <span class="serif">Just credit us.</span></h2>
        <p>The data is published under the Creative Commons Attribution 4.0 International licence (CC BY 4.0). You can copy, share, chart and build on it, including commercially. The one condition: credit MedEazy wherever you use it.</p>
        <a href="https://creativecommons.org/licenses/by/4.0/" target="_blank" rel="noopener license">Read the full CC BY 4.0 licence →</a>
      </div>
      <div class="col">
        <div class="credit">
          <div class="lbl">Credit line to use</div>
          <div class="line" id="mzd-credit">Source: MedEazy (medeazy.co.uk/data)</div>
          <div class="note">Online, please link the credit to <span class="mono">https://medeazy.co.uk/data</span>. In print or broadcast, say "according to price comparison site MedEazy".</div>
          <button type="button" class="copy" id="mzd-copy">Copy credit line</button>
        </div>
        <div class="do">
          <div><strong>You can</strong><span>Republish figures, make charts, use it in reports, products and research</span></div>
          <div><strong>You must</strong><span>Credit MedEazy, link back online, and say if you changed the data</span></div>
        </div>
      </div>
    </div>
  </section>

  <section class="wrap meth" id="methodology" aria-labelledby="mzd-h-method">
    <span class="eyebrow">Methodology</span>
    <h2 id="mzd-h-method">How we collect and check the data</h2>
    <p class="intro">We publish the method in full so you can judge the numbers for yourself. If something looks wrong, tell us and we'll correct it.</p>
    <div class="grid grid-300" style="gap:20px">
      <div class="step"><div class="num">1</div><h3>Which pharmacies are included</h3><p>UK online pharmacies that supply weight loss treatments after an online consultation. Each is checked on the public GPhC register before it is listed, and reviewed periodically to confirm continued registration.</p></div>
      <div class="step"><div class="num">2</div><h3>How prices are collected</h3><p>We check pharmacy prices daily and update MedEazy when they change. Every change on MedEazy is logged automatically within the hour, with a timestamp, in the history file.</p></div>
      <div class="step"><div class="num">3</div><h3>What a price means</h3><p>The private price for a monthly supply of each dose, as shown on MedEazy. Prices usually include consultation, prescription and standard delivery; some pharmacies add fees. Where a pharmacy offers a discount code, it is listed alongside the price.</p></div>
      <div class="step"><div class="num">4</div><h3>Quality checks</h3><p>Any price that moves more than 40% at once is held for three hours and checked before it enters the record, so typing errors never reach the history file.</p></div>
      <div class="step"><div class="num">5</div><h3>Corrections</h3><p>Pharmacies and readers can report an error through our <a href="/pages/contact">contact page</a>. Confirmed corrections are made quickly and appear in the history file.</p></div>
      <div class="step"><div class="num">6</div><h3>Independence</h3><p>No pharmacy pays for placement or ranking. We may earn a commission when someone clicks through to a pharmacy; this never affects the data or its order.</p></div>
    </div>
    <div class="grid grid-300" style="gap:20px;margin-top:32px">
      <div class="box warn"><h3>Limitations</h3><p>Prices are the prices shown on MedEazy, not what every patient pays. Consultation or delivery fees and one-off codes can change the final cost. Pharmacies not listed on MedEazy are not included, so the data covers most but not all of the UK private market.</p></div>
      <div class="box log"><h3 style="color:var(--ink)">Changelog</h3><div><strong>Oct 2026</strong> · Dataset first published</div></div>
    </div>
  </section>

  <section class="wrap sec" id="embed" aria-labelledby="mzd-h-embed">
    <div class="embed">
      <div>
        <h2 id="mzd-h-embed">Embed the live chart</h2>
        <p>Paste this into any article or report. It updates automatically and carries the credit.</p>
      </div>
      <pre class="code">&lt;iframe src="{{ base }}/embed/mounjaro-spread.html"
  width="100%" height="420" loading="lazy"
  title="Mounjaro prices by dose – MedEazy"&gt;&lt;/iframe&gt;</pre>
    </div>
  </section>

  <section class="wrap" id="press" aria-labelledby="mzd-h-press" style="padding-top:24px;padding-bottom:80px">
